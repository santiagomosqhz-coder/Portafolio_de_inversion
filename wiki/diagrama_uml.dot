digraph UML {
  rankdir=TB; nodesep=0.35; ranksep=0.7; dpi=140;
  node [shape=record, fontname="DejaVu Sans", fontsize=9, style=filled];
  edge [fontname="DejaVu Sans", fontsize=8];
  Almacen [fillcolor="#FFF2CC", label="{Almacen||+ cargar()\l+ cargar_cdt()\l+ guardar(operaciones, renta_fija)\l+ guardar_cdt(cdts)\l}"];
  AnalisisPortafolio [fillcolor="#DCEBF7", label="{AnalisisPortafolio|+ fecha_calculo: date\l+ posiciones: List[Posicion]\l+ renta_fija: List[InversionRentaFija]\l+ resumenes: Dict[str, Resumen]\l+ evolucion: Dict[str, DataFrame]\l+ advertencias: List[str]\l+ errores: Dict[str, str]\l+ fuentes: Dict[str, Tuple[str, datetime]]\l|+ esta_completo «propiedad»\l}"];
  CalculadoraRentabilidad [fillcolor="#E2F0D9", label="{CalculadoraRentabilidad||+ rentabilidad_simple(ganancia, base)\l+ xirr(flujos)\l+ rentabilidad_ea(flujos)\l}"];
  Cartera [fillcolor="#E2F0D9", label="{Cartera|+ portafolio: Portafolio\l+ servicio: ServicioPrecios\l|+ saldo()\l+ datos_en_cop(simbolo, desde, hoy)\l+ preparar_compra(empresa, cantidad, fecha_compra, fecha_venta, hoy)\l+ registrar_compra(operacion, datos, hoy)\l+ preparar_ventas_pendientes(hoy)\l+ registrar_ventas(ventas, hoy)\l+ estado(hoy)\l}"];
  Cdt [fillcolor="#DCEBF7", label="{Cdt|+ monto: float\l+ tasa_ea: float\l+ fuente: str\l+ fecha_tasa: date\l+ id: str\l|+ validar(hoy)\l+ rentabilidad_diaria «propiedad»\l+ ganancia_diaria «propiedad»\l+ ganancia_anual_estimada «propiedad»\l+ a_dict()\l+ desde_dict(d)\l}"];
  Configuracion [fillcolor="#FFF2CC", label="{Configuracion|+ ruta_datos: Path\l+ alphavantage_clave: Optional[str]\l|+ cargar(ruta_datos)\l}"];
  DatosMercado [fillcolor="#DCEBF7", label="{DatosMercado|+ simbolo: str\l+ cierres: Series\l+ dividendos: Series\l+ splits: Series\l+ moneda: Optional[str]\l+ nombre: Optional[str]\l+ fuente: str\l+ consultado_en: datetime\l+ soporta_dividendos: bool\l+ soporta_splits: bool\l|+ precio_en(fecha)\l+ lista_splits «propiedad»\l+ lista_dividendos «propiedad»\l}"];
  Empresa [fillcolor="#DCEBF7", label="{Empresa|+ nombre: str\l+ simbolo: str\l|+ todas()\l+ por_simbolo(simbolo)\l+ por_nombre(nombre)\l}"];
  ErrorPrecios [fillcolor="#FFF2CC", label="{«Exception»\nErrorPrecios||}"];
  EstadoCartera [fillcolor="#DCEBF7", label="{EstadoCartera|+ hoy: date\l+ saldo: float\l+ lotes: List[Lote]\l+ errores: Dict[str, str]\l+ fuente: Optional[str]\l+ consultado_en: Optional[datetime]\l|+ abiertas «propiedad»\l+ cerradas «propiedad»\l+ valor_abiertas «propiedad»\l+ valor_total «propiedad»\l+ realizada «propiedad»\l+ no_realizada «propiedad»\l+ esta_completo «propiedad»\l}"];
  GraficaInteractiva [fillcolor="#F4DFF0", label="{«Frame»\nGraficaInteractiva|+ al_seleccionar: Optional[Callable[[date, float, Optional[flo\l|+ limpiar(mensaje)\l+ mostrar(datos, titulo, fecha_compra, fecha_venta_prevista, hoy, venta_ocurrida)\l+ seleccionar(indice)\l}"];
  InterfazGrafica [fillcolor="#F4DFF0", label="{InterfazGrafica|+ raiz: tk.Tk\l+ cartera: Cartera\l+ estado: Optional[EstadoCartera]\l|}"];
  InversionRentaFija [fillcolor="#DCEBF7", label="{InversionRentaFija|+ tipo: str\l+ nombre: str\l+ fecha_compra: date\l+ capital: float\l+ tasa_ea: float\l+ fecha_vencimiento: date\l+ comision: float\l+ moneda: str\l+ valor_mercado: Optional[float]\l+ fecha_valor_mercado: Optional[date]\l+ fecha_venta: Optional[date]\l+ valor_venta: Optional[float]\l+ comision_venta: float\l+ id: str\l|+ validar(hoy)\l+ costo «propiedad»\l+ valor_causado(fecha)\l+ valor_al_vencimiento «propiedad»\l+ estado(hoy)\l+ valor_actual(hoy)\l+ valor_vigente(hoy)\l+ ganancia(hoy)\l+ es_realizada(hoy)\l+ flujos(hoy)\l+ a_dict()\l+ desde_dict(d)\l}"];
  Lote [fillcolor="#DCEBF7", label="{Lote|+ empresa: str\l+ simbolo: str\l+ compra: Operacion\l+ venta: Optional[Operacion]\l+ acciones: float\l+ precio_actual: Optional[float]\l+ fecha_precio: Optional[date]\l|+ abierta «propiedad»\l+ fecha_venta_prevista «propiedad»\l+ costo «propiedad»\l+ valor_actual «propiedad»\l+ dinero_recibido «propiedad»\l+ ganancia_no_realizada «propiedad»\l+ ganancia_realizada «propiedad»\l+ ganancia «propiedad»\l+ rentabilidad «propiedad»\l}"];
  Operacion [fillcolor="#DCEBF7", label="{Operacion|+ simbolo: str\l+ tipo: str\l+ fecha: date\l+ cantidad: float\l+ precio: float\l+ comision: float\l+ moneda: str\l+ id: str\l+ fecha_venta_prevista: Optional[date]\l+ compra_id: Optional[str]\l|+ validar(hoy)\l+ monto_bruto «propiedad»\l+ es_compra «propiedad»\l+ flujo_caja «propiedad»\l+ a_dict()\l+ desde_dict(d)\l}"];
  Portafolio [fillcolor="#E2F0D9", label="{Portafolio|+ almacen: Almacen\l+ operaciones: List[Operacion]\l+ renta_fija: List[InversionRentaFija]\l+ cdts: List[Cdt]\l|+ simbolos «propiedad»\l+ registrar_operacion(op, splits, hoy)\l+ eliminar_operacion(id_operacion)\l+ registrar_renta_fija(inversion, hoy)\l+ actualizar_renta_fija(inversion, hoy)\l+ eliminar_renta_fija(id_inversion)\l+ registrar_cdt(cdt, hoy)\l+ eliminar_cdt(id_cdt)\l+ factor_split(splits, fecha)\l+ analizar(servicio, hoy)\l}"];
  Posicion [fillcolor="#DCEBF7", label="{Posicion|+ simbolo: str\l+ moneda: str\l+ nombre: Optional[str]\l+ cantidad: float\l+ costo_abierto: float\l+ precio_actual: float\l+ fecha_precio: date\l+ total_comprado: float\l+ ventas_netas: float\l+ costo_vendido: float\l+ realizada: float\l+ dividendos: float\l+ flujos: List[Tuple[date, float]]\l|+ esta_abierta «propiedad»\l+ costo_promedio «propiedad»\l+ valor_actual «propiedad»\l+ no_realizada «propiedad»\l+ no_realizada_pct «propiedad»\l+ realizada_pct «propiedad»\l+ ganancia_total «propiedad»\l+ rentabilidad_acumulada «propiedad»\l+ rentabilidad_ea «propiedad»\l}"];
  ProveedorAlphaVantage [fillcolor="#FFF2CC", label="{ProveedorAlphaVantage||+ obtener(simbolo, inicio, fin)\l}"];
  ProveedorCOP [fillcolor="#FFF2CC", label="{ProveedorCOP|+ base: ProveedorPrecios\l+ simbolo_fx: str\l+ moneda_por_defecto: str\l|+ obtener(simbolo, inicio, fin)\l}"];
  ProveedorPrecios [fillcolor="#FFF2CC", label="{«abstracta»\n«ABC»\nProveedorPrecios|+ nombre: str\l+ requiere_clave: bool\l|+ obtener(simbolo, inicio, fin)\l}"];
  ProveedorYahoo [fillcolor="#FFF2CC", label="{ProveedorYahoo||+ obtener(simbolo, inicio, fin)\l}"];
  Resumen [fillcolor="#DCEBF7", label="{Resumen|+ moneda: str\l+ invertido_rv: float\l+ invertido_rf: float\l+ valor_rv: float\l+ valor_rf: float\l+ realizada_rv: float\l+ realizada_rf: float\l+ no_realizada_rv: float\l+ no_realizada_rf: float\l+ dividendos: float\l+ rentabilidad_ea: Optional[float]\l+ dias: int\l|+ total_invertido «propiedad»\l+ valor_actual «propiedad»\l+ realizada «propiedad»\l+ no_realizada «propiedad»\l+ ganancia_rv «propiedad»\l+ ganancia_rf «propiedad»\l+ ganancia_total «propiedad»\l+ rentabilidad_acumulada «propiedad»\l+ pct_rv «propiedad»\l+ pct_rf «propiedad»\l}"];
  ServicioPrecios [fillcolor="#FFF2CC", label="{ServicioPrecios|+ proveedores: List[ProveedorPrecios]\l|+ obtener(simbolo, inicio, fin)\l+ limpiar()\l}"];
  TareaSegundoPlano [fillcolor="#F4DFF0", label="{TareaSegundoPlano||+ ejecutar(widget, funcion, al_terminar)\l}"];
  Tema [fillcolor="#F4DFF0", label="{Tema||+ color_resultado(valor)\l}"];
  ProveedorAlphaVantage -> ProveedorPrecios [arrowhead=empty];
  ProveedorCOP -> ProveedorPrecios [arrowhead=empty];
  ProveedorYahoo -> ProveedorPrecios [arrowhead=empty];
  AnalisisPortafolio -> InversionRentaFija [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  AnalisisPortafolio -> Posicion [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  AnalisisPortafolio -> Resumen [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Cartera -> Portafolio [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Cartera -> ServicioPrecios [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  EstadoCartera -> Lote [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  InterfazGrafica -> Cartera [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  InterfazGrafica -> EstadoCartera [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Lote -> Operacion [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Portafolio -> Almacen [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Portafolio -> Cdt [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Portafolio -> InversionRentaFija [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Portafolio -> Operacion [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  ProveedorCOP -> ProveedorPrecios [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  ServicioPrecios -> ProveedorPrecios [arrowhead=vee, arrowtail=odiamond, dir=both, label="tiene"];
  Almacen -> Cdt [arrowhead=vee, style=dashed, color="#6B7280"];
  Almacen -> InversionRentaFija [arrowhead=vee, style=dashed, color="#6B7280"];
  Almacen -> Operacion [arrowhead=vee, style=dashed, color="#6B7280"];
  Cartera -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  Cartera -> Empresa [arrowhead=vee, style=dashed, color="#6B7280"];
  Cartera -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  Cartera -> EstadoCartera [arrowhead=vee, style=dashed, color="#6B7280"];
  Cartera -> Lote [arrowhead=vee, style=dashed, color="#6B7280"];
  Cartera -> Operacion [arrowhead=vee, style=dashed, color="#6B7280"];
  DatosMercado -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  GraficaInteractiva -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  GraficaInteractiva -> Tema [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> Cdt [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> Empresa [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> GraficaInteractiva [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> Operacion [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> Portafolio [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> TareaSegundoPlano [arrowhead=vee, style=dashed, color="#6B7280"];
  InterfazGrafica -> Tema [arrowhead=vee, style=dashed, color="#6B7280"];
  Portafolio -> AnalisisPortafolio [arrowhead=vee, style=dashed, color="#6B7280"];
  Portafolio -> CalculadoraRentabilidad [arrowhead=vee, style=dashed, color="#6B7280"];
  Portafolio -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  Portafolio -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  Portafolio -> Posicion [arrowhead=vee, style=dashed, color="#6B7280"];
  Portafolio -> Resumen [arrowhead=vee, style=dashed, color="#6B7280"];
  Portafolio -> ServicioPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  Posicion -> CalculadoraRentabilidad [arrowhead=vee, style=dashed, color="#6B7280"];
  ProveedorAlphaVantage -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  ProveedorAlphaVantage -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  ProveedorCOP -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  ProveedorCOP -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  ProveedorPrecios -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  ProveedorYahoo -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  ProveedorYahoo -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
  ServicioPrecios -> DatosMercado [arrowhead=vee, style=dashed, color="#6B7280"];
  ServicioPrecios -> ErrorPrecios [arrowhead=vee, style=dashed, color="#6B7280"];
}